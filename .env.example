# Copy to .env.local and fill in real values.
# Never commit .env.local.

ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Duffel sandbox only — token must start with duffel_test_
# Do not use DUFFEL_TEST_API_KEY (orphan / unused). Use DUFFEL_API_KEY.
DUFFEL_API_KEY=

# Viator Partner API (server-only — never NEXT_PUBLIC_)
VIATOR_API_KEY=
# Optional: set to "true" for sandbox host if your partner account uses it
VIATOR_SANDBOX=
