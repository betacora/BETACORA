# Copy to .env.local and fill in real values.
# Never commit .env.local.

ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for account deletion (Auth admin deleteUser).
# Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Duffel sandbox only — token must start with duffel_test_
# Do not use DUFFEL_TEST_API_KEY (orphan / unused). Use DUFFEL_API_KEY.
DUFFEL_API_KEY=

# Viator Partner API (server-only — never NEXT_PUBLIC_)
VIATOR_API_KEY=
# Optional: set to "true" for sandbox host if your partner account uses it
VIATOR_SANDBOX=

# Google Places API (New) — server-only Text Search proxy (/api/places/search).
# Never expose as NEXT_PUBLIC_* (key must not reach the browser).
GOOGLE_PLACES_API_KEY=

# Upstash Redis (server-only — never NEXT_PUBLIC_) — rate limiting for paid APIs.
# Required for fail-closed routes (generate-itinerary, assistant-chat, places/search, …).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
